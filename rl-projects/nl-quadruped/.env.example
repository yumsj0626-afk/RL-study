# 이 파일을 복사해서 `.env` 로 만들고 실제 값을 채우세요.
#   cp .env.example .env   (PowerShell:  Copy-Item .env.example .env)
# `.env` 는 .gitignore 로 보호되므로 커밋되지 않습니다. 실제 키를 여기(.env.example)에 적지 마세요.

# ---- OpenAI (자연어 파서용) ----
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
# ---- 파서 설정 (선택) ----
NLQ_PARSER_MODEL=claude-sonnet-4-6

# ---- AWS 산출물 버킷 (Phase 1 이후 채움) ----
# AWS 자격증명 자체는 여기 넣지 말고 `aws configure --profile rl-capstone` 로 ~/.aws 에 둡니다.
AWS_PROFILE=rl-capstone
AWS_REGION=us-east-1
NLQ_S3_BUCKET=
